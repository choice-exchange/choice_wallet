{
  "manifest_version": 3,
  "name": "Choice Wallet",
  "version": "0.1.0",
  "description": "Open-source, self-custody wallet for Injective. Pre-alpha: not for real funds.",
  "minimum_chrome_version": "120",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Choice Wallet" },
  "permissions": ["storage", "alarms"],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; require-trusted-types-for 'script'"
  }
}
