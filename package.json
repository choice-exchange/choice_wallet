{
  "name": "choice-wallet",
  "private": true,
  "type": "module",
  "workspaces": [
    "chain",
    "ui",
    "extension"
  ],
  "scripts": {
    "check": "tsc -p chain && tsc -p ui && tsc -p extension",
    "build": "npm run build -w extension",
    "dev": "npm run dev -w extension",
    "test": "npm test -w chain && npm test -w ui && npm test -w extension",
    "e2e": "npm run e2e -w extension --"
  },
  "devDependencies": {
    "@types/chrome": "0.3.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
